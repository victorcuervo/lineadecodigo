// fallback
const getIcon = (label: string) =>
  iconMap[label.toLowerCase()] ?? iconMap["web"];

---

<style>
/* Estilos del bloque de autor (responsivos: se adaptan al ancho del contenedor) */
.author-card {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px;
    background-color: #f9f9f9;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.08);
    font-family: 'Arial', sans-serif;
}

.author-photo {
    width: clamp(56px, 12%, 80px);
    height: clamp(56px, 12%, 80px);
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid #ddd;
    flex: 0 0 auto;
}

.author-info {
    flex: 1 1 auto;
    min-width: 0; /* evita overflow en textos largos dentro de flex */
}

.author-name {
    margin: 0;
    font-size: 1.2rem;
    font-weight: bold;
    color: #333;
    word-break: break-word;
}

.author-bio {
    margin: 5px 0 10px;
    font-size: 0.95rem;
    color: #555;
}

.author-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.author-socials a {
    display: inline-block;
    transition: transform 0.2s;
}

.author-socials a:hover {
    transform: scale(1.1);
}

/* Adaptación en pantallas pequeñas: apilar contenido */
@media (max-width: 600px) {
    .author-card {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
        padding: 12px;
    }

    .author-photo {
        width: 64px;
        height: 64px;
    }

    .author-name {
        font-size: 1.05rem;
    }
}
</style>


{author && (
    <div class="author-card">
    <img src="https://secure.gravatar.com/avatar/8d3fa1a20bfaf3497ac4667124df6cd13a478b0f5dce0d285712c57fe13e9ac3?s=172&d=robohash&r=g" alt="Foto de Juan Pérez" class="author-photo">
    <div class="author-info">
        <h3 class="author-name"> {author.name} </h3>
        <p class="author-bio">  {author.description} </p>

        <div class="author-socials">
            {author.rrss?.map(s => (
            <a href={s.url} target="_blank" rel="noopener noreferrer">
                <span set:html={getIcon(s.label)} />
            </a>
            ))}
        </div>

    </div>
    </div>
)}



