---
import Default from '@astrojs/starlight/components/Footer.astro';
import DownloadSource from './DownloadSource.astro';
import ArticleList from './ArticleList.astro';
import AuthorCard from './AuthorCard.astro'
import Quiz from './Quiz.astro';
import Video from './Video.astro';

const { entry } = Astro.locals.starlightRoute;
const frontmatter = entry?.rendered?.metadata?.frontmatter ?? entry?.data ?? {};
const {title, author, download, type, video} = frontmatter as Record<string, any>;
const slug = entry?.slug;
const description = entry?.data?.description;

// Si el type es "category" la category es directamente el slug
// En caso contrario (doc) es el slug sin la última parteP
const category = type === "category" ? slug : (slug !== undefined ? slug.split('/').slice(0, -1).join('/') : '');
const year = new Date().getFullYear();
---

<section class="article-end-wrapper">


  {author && author !== undefined && type != 'category' && (
    <div class="article-end-block">
      <AuthorCard id={author} />
    </div>
  )} 

  {video && video !== '' &&  (
    <div class="article-end-block">
      <Video videoUrl={video} videoTitle={title}/>
    </div>
  )}

  {download && download !== '' && (
    <div class="article-end-block">
      <DownloadSource
        title={`${title}`}
        description={`${description}`}
        href={`${download}`}
        label="Descargar código"
      />
    </div>
  )}

  { type === 'category' && (
  <div class="article-end-block">
    <ArticleList titulo={`${title}`} categoria={`${category}`} />
  </div>
  )} 

  <div class="article-end-block">
    <Quiz theme={`${category}`} />
  </div>

</section>

<style>
.article-end-wrapper {
  display: flex;
  flex-direction: column;
  gap: 2rem; /* separación principal entre bloques */
  margin-top: 3rem; /* separación respecto al contenido del artículo */
}


.article-end-block {
  padding-top: 1rem;
  border-top: 1px solid var(--sl-color-border-muted);
}

.article-end-block:first-child {
  border-top: none; /* no borde en el primer bloque */
  padding-top: 0;
}

/* Mobile adjustments */
@media (max-width: 640px) {
  .article-end-wrapper {
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .article-end-block {
    padding-top: 0.75rem;
  }
}
</style>

<Default><slot /></Default>

<footer class="sl-footer">
  <div class="sl-footer__container">

    <div class="sl-footer__column">
      <h3>Nosotros</h3>
      <ul>
        <li><a href="/acerca-de/">Acerca de</a></li>
        <li><a href="/colaborar/">Colaborar</a></li>
        <li><a href="/publicidad/">Publicidad</a></li>
        <li><a href="/contactar/">Contactar</a></li>
        <li><a href="/privacidad/">Privacidad</a></li>
        <li><a href="/cookies/">Cookies</a></li>
      </ul>
    </div>

    <div class="sl-footer__column">
      <h3>Nuestras Webs</h3>
      <ul>
        <li><a href="https://www.manualweb.net">Manual Web</a></li>
        <li><a href="https://www.w3api.com">W3Api</a></li>
        <li><a href="https://www.testprogramacion.com">Test de Programación</a></li>
        <li><a href="https://www.informatica-juridica.com">Informática Jurídica</a></li>
      </ul>
    </div>

    <div class="sl-footer__column">
      <h3>Línea de Código</h3>
      <p>Comunidad dedicada a que cualquier persona pueda <strong>aprender a programar</strong> de manera clara, estructurada y práctica, independientemente de su nivel de experiencia.</p>
    </div>

  </div>

  <div class="sl-footer__bottom">
    <p>© {year} Línea de Código. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
.sl-footer {
  background-color: var(--sl-color-bg);
  color: var(--sl-color-text);
  padding: 3rem 1.5rem 1.5rem;  
  border-top: 1px solid var(--sl-color-gray-1);
}

.sl-footer__container {
  max-width: 72rem;
  margin: 0 auto;
  display: flex;
  gap: 2rem;
}

.sl-footer__column {
  flex: 1;
  min-width: 220px;
}

.sl-footer__column h3 {
  margin-bottom: 1rem;
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--sl-color-text-strong);
}

.sl-footer__column p,
.sl-footer__column li {
  font-size: 0.875rem;
  line-height: 1.6;
  color: var(--sl-color-text);
}

.sl-footer__column ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.sl-footer__column a {
  color: var(--sl-color-accent);
  text-decoration: none;
}

.sl-footer__column a:hover {
  text-decoration: underline;
}

/* =========================
   Footer bottom
   ========================= */

.sl-footer__bottom {
  margin-top: 2rem;
  padding-top: 1rem;
  text-align: center;
  font-size: 0.75rem;
  color: var(--sl-color-text);  
}

/* =========================
   Responsive
   ========================= */

@media (max-width: 768px) {
  .sl-footer__container {
    flex-direction: column;
    text-align: center;
  }
}

</style>