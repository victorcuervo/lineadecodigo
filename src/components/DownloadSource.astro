---
import { undefined } from 'astro:schema';

interface Props {
  title?: string;
  description?: string;
  href?: string;
  label?: string;
}

const {
  title = 'Código fuente',
  description = 'Descarga el código completo de este artículo.',
  href,
  label = 'Descargar',
} = Astro.props;

// Validar que href sea un string válido y no "undefined"
const hasHref = href && href !== 'undefined';
---

{hasHref && (<div class="download-card">
  <div class="download-content">
    <h3 class="download-title">Descarga el código de {title}</h3>
    <p class="download-description">{description}</p>
  </div>

  <a
    class="download-action"
    href={href}
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="download-icon" aria-hidden="true">
      ↓
    </span>
    {label}
  </a>
</div>

<style>
/* ======================================================
   Download Source Card – integrado con Starlight
   ====================================================== */

.download-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1.25rem;

  padding: 1.25rem 1.5rem;
  border-radius: 14px;

  background-color: var(--sl-color-bg);
  border: 1px solid var(--sl-color-border);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);

  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.download-card:hover {
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
}

.download-content {
  flex: 1 1 auto;
  min-width: 0;
}

.download-title {
  margin: 0 0 0.25rem;
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--sl-color-text);
}

.download-description {
  margin: 0;
  font-size: 0.95rem;
  color: var(--sl-color-text-muted);
}

/* ======================================================
   Acción
   ====================================================== */

.download-action {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;

  white-space: nowrap;

  padding: 0.6rem 0.9rem;
  border-radius: 999px;

  font-size: 0.9rem;
  font-weight: 500;
  text-decoration: none;

  color: var(--sl-color-text-invert);
  background-color: var(--sl-color-accent);

  transition:
    background-color 0.2s ease,
    transform 0.15s ease,
    box-shadow 0.15s ease;
}

.download-action:hover {
  background-color: var(--sl-color-accent-high);
  transform: translateY(-1px);
}

.download-action:active {
  transform: translateY(0);
}

/* Icono */
.download-icon {
  font-size: 1rem;
  line-height: 1;
}

/* ======================================================
   Responsive
   ====================================================== */

@media (max-width: 600px) {
  .download-card {
    flex-direction: column;
    align-items: flex-start;
  }

  .download-action {
    align-self: flex-start;
  }
}
</style>
)}