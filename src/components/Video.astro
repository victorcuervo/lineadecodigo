---
/* 
    Componente que nos muestra el vídeo asociado a un artículo 
    La URL del vídeo viene como entrada del componente 
    El vídeo es un vídeo de Youtube
*/

const {
  videoUrl,
  videoTitle
} = Astro.props;
---
<div class="video-container">
    <h2>Vídeo sobre {videoTitle}</h2>
    <iframe 
        src={videoUrl} 
        title={`Vídeo sobre ${videoTitle}`}
        frameborder="0" 
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
        allowfullscreen
    ></iframe>    
</div>