---
import Default from "@astrojs/starlight/components/Head.astro";
import type { BlogPosting, CollectionPage, TechArticle, WithContext } from "schema-dts";
import { authors } from "../configs/authors.config";


const { entry } = Astro.locals.starlightRoute;
const frontmatter = entry?.rendered?.metadata?.frontmatter ?? entry?.data ?? {};
const {title = "", author: authorId = "", publishDate = "", updatedDate, tags = [], video} = frontmatter as Record<string, any>;
const slug = entry?.slug;
const description = entry?.data?.description;
const type = entry?.data?.type ?? "blog";// Imagen y texto alternativo para las redes sociales
import { getImage } from 'astro:assets';
import defaultCover from '../assets/cover.webp';

const img = await getImage({
  src: entry?.data?.socialImage ?? defaultCover
});

const ogImageUrl = new URL(img.src, Astro.site).href;

let imgAlt = entry?.data?.socialImageAlt
  ? `Ejemplo de ${entry.data.socialImageAlt}`
  : "Ejemplo de Línea de Código";

// Resolver autor desde config
let author = authorId ? authors.find(a => a.id === authorId) : 'lineadecodigo';
// Canonical absoluto
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();


// En la metatdata viene el tipo de documento. Los tipo doc son un JSON-LD TechArticle
// los tipo category son un JSON-LD CollectionPage y los tipo blog son un JSON-LD BlogPosting

console.log(video)

const techArticleSchema: WithContext<TechArticle> = {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description: description,
    url: Astro.url.href,
    datePublished: publishDate,
    dateModified: updatedDate ?? publishDate,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalUrl
    },
    author: author && {
      "@type": "Person",
      name: author.name,
      image: author.photo,
      sameAs: author.rrss?.map(r => r.url) ?? []
    }, 
    keywords: tags?.join(", "),
    publisher: {
      "@type": "Organization",
      name: "Línea de Código",
      url: "https://lineadecodigo.com",
      logo: {
        "@type": "ImageObject",
        url: "https://lineadecodigo.com/logo.webp",
        width: 400,
        height: 365
      },
      sameAs: [
        "https://www.linkedin.com/company/lineadecodigo",
        "https://www.facebook.com/lineadecodigo",
        "https://www.instagram.com/lineadecodigo/",
        "https://www.youtube.com/user/lineadecodigo"
      ]
    },
    video: video && {
      "@type": "VideoObject",
      name: `Vídeo sobre ${title}`,
      description: description,
      contentUrl: `https://www.youtube.com/watch?v=${video}`,
      embedUrl: `https://www.youtube.com/embed/${video}`,
      thumbnailUrl: [ogImageUrl]
    }
};
 
const collectionPageSchema: WithContext<CollectionPage> = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    headline: title,
    description: description,
    url: Astro.url.href,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalUrl
    },
};

const blogPostingSchema: WithContext<BlogPosting> = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description: description,
    url: Astro.url.href,
    datePublished: publishDate,
    dateModified: updatedDate ?? publishDate,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalUrl
    },
};

let articleSchemaFinal;
if (type === "doc") {
    articleSchemaFinal = techArticleSchema;
} else if (type === "category") {
    articleSchemaFinal = collectionPageSchema;
} else {
    articleSchemaFinal = blogPostingSchema;
}
---

<Default {...Astro.props} />

<meta property="og:image" content={ogImageUrl} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="og:image:alt" content={imgAlt} />
<meta name="twitter:image:alt" content={imgAlt} />

<script 
    type="application/ld+json" 
    set:html={JSON.stringify(articleSchemaFinal)}>
</script>



